<?xml version="1.0"?>
<!--
  2足歩行ロボット URDF
  構造:
    torso (胴体, floating base)
    ├── left_hip  (revolute, Y軸)
    │   └── left_upper_leg
    │       └── left_knee (revolute, Y軸)
    │           └── left_lower_leg
    │               └── left_ankle (revolute, Y軸)
    │                   └── left_foot
    └── right_hip (revolute, Y軸)
        └── right_upper_leg
            └── right_knee (revolute, Y軸)
                └── right_lower_leg
                    └── right_ankle (revolute, Y軸)
                        └── right_foot

  寸法:
    胴体:      0.20 x 0.15 x 0.30 m  (5.0 kg)
    上脚:      0.06 x 0.06 x 0.20 m  (1.0 kg)
    下脚:      0.05 x 0.05 x 0.20 m  (0.8 kg)
    足:        0.15 x 0.08 x 0.02 m  (0.3 kg)
    総質量:    9.2 kg
-->
<robot name="biped">

  <!-- ===== 胴体 ===== -->
  <link name="torso">
    <visual>
      <geometry><box size="0.20 0.15 0.30"/></geometry>
      <material name="blue"><color rgba="0.20 0.40 0.80 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.20 0.15 0.30"/></geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <!-- box: ixx=m(y²+z²)/12 -->
      <inertia ixx="0.0469" ixy="0.0" ixz="0.0"
               iyy="0.0542" iyz="0.0"
               izz="0.0260"/>
    </inertial>
  </link>

  <!-- ===== 左脚 ===== -->

  <joint name="left_hip" type="revolute">
    <parent link="torso"/>
    <child  link="left_upper_leg"/>
    <origin xyz="0.0 0.075 -0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="0.8" effort="100" velocity="5"/>
    <dynamics damping="0.5"/>
  </joint>

  <link name="left_upper_leg">
    <visual>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.20"/></geometry>
      <material name="lgrey"><color rgba="0.65 0.65 0.65 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.20"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.00363" ixy="0.0" ixz="0.0"
               iyy="0.00363" iyz="0.0"
               izz="0.00060"/>
    </inertial>
  </link>

  <joint name="left_knee" type="revolute">
    <parent link="left_upper_leg"/>
    <child  link="left_lower_leg"/>
    <origin xyz="0.0 0.0 -0.20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- 膝は常に前方向のみに曲がる -->
    <limit lower="-0.05" upper="1.57" effort="100" velocity="5"/>
    <dynamics damping="0.5"/>
  </joint>

  <link name="left_lower_leg">
    <visual>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.20"/></geometry>
      <material name="lgrey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.20"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.00283" ixy="0.0" ixz="0.0"
               iyy="0.00283" iyz="0.0"
               izz="0.000333"/>
    </inertial>
  </link>

  <joint name="left_ankle" type="revolute">
    <parent link="left_lower_leg"/>
    <child  link="left_foot"/>
    <origin xyz="0.0 0.0 -0.20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.6" upper="0.6" effort="60" velocity="5"/>
    <dynamics damping="0.3"/>
  </joint>

  <link name="left_foot">
    <visual>
      <origin xyz="0.04 0 -0.01" rpy="0 0 0"/>
      <geometry><box size="0.15 0.08 0.02"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.04 0 -0.01" rpy="0 0 0"/>
      <geometry><box size="0.15 0.08 0.02"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.04 0 -0.01" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.000170" ixy="0.0" ixz="0.0"
               iyy="0.000573" iyz="0.0"
               izz="0.000723"/>
    </inertial>
  </link>

  <!-- ===== 右脚 (左脚を y 反転) ===== -->

  <joint name="right_hip" type="revolute">
    <parent link="torso"/>
    <child  link="right_upper_leg"/>
    <origin xyz="0.0 -0.075 -0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="0.8" effort="100" velocity="5"/>
    <dynamics damping="0.5"/>
  </joint>

  <link name="right_upper_leg">
    <visual>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.20"/></geometry>
      <material name="lgrey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.20"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.00363" ixy="0.0" ixz="0.0"
               iyy="0.00363" iyz="0.0"
               izz="0.00060"/>
    </inertial>
  </link>

  <joint name="right_knee" type="revolute">
    <parent link="right_upper_leg"/>
    <child  link="right_lower_leg"/>
    <origin xyz="0.0 0.0 -0.20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.05" upper="1.57" effort="100" velocity="5"/>
    <dynamics damping="0.5"/>
  </joint>

  <link name="right_lower_leg">
    <visual>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.20"/></geometry>
      <material name="lgrey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.20"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.00283" ixy="0.0" ixz="0.0"
               iyy="0.00283" iyz="0.0"
               izz="0.000333"/>
    </inertial>
  </link>

  <joint name="right_ankle" type="revolute">
    <parent link="right_lower_leg"/>
    <child  link="right_foot"/>
    <origin xyz="0.0 0.0 -0.20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.6" upper="0.6" effort="60" velocity="5"/>
    <dynamics damping="0.3"/>
  </joint>

  <link name="right_foot">
    <visual>
      <origin xyz="0.04 0 -0.01" rpy="0 0 0"/>
      <geometry><box size="0.15 0.08 0.02"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.04 0 -0.01" rpy="0 0 0"/>
      <geometry><box size="0.15 0.08 0.02"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.04 0 -0.01" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.000170" ixy="0.0" ixz="0.0"
               iyy="0.000573" iyz="0.0"
               izz="0.000723"/>
    </inertial>
  </link>

</robot>
